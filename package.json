{
  "name": "allure-report-storage",
  "version": "1.1.2",
  "private": true,
  "description": "",
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "scripts": {
    "build": "node ./scripts/run-build.cjs",
    "clean": "rimraf ./dist ./out ./allure-report",
    "format": "yarn format:write",
    "format:check": "node ./scripts/run-oxfmt.cjs --check",
    "format:write": "node ./scripts/run-oxfmt.cjs --write",
    "lint": "node ./scripts/run-lint.cjs",
    "lint:fix": "node ./scripts/run-lint.cjs --fix",
    "lint:type": "node ./scripts/run-type-lint.cjs",
    "postinstall": "git config --local core.hooksPath .husky/_ || true",
    "test:e2e": "vitest run --config ./vitest.e2e.config.mts",
    "test:unit": "vitest run --config ./vitest.config.mts",
    "test:report": "allure generate ./out/allure-results",
    "start": "node ./dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@hono/node-server": "^2.1.3",
    "hono": "4.13.8",
    "kysely": "^0.29.7",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "allure": "^3.21.0",
    "allure-vitest": "^3.10.2",
    "lefthook": "^2.2.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.79.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "resolutions": {
    "adm-zip": "0.6.1",
    "axios": "1.20.0",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.13",
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": "5.10.1",
    "http-cache-semantics": "4.3.0",
    "ip-address": "10.7.1",
    "linkify-it": "5.0.2",
    "markdown-it": "14.3.1",
    "nanoid@npm:^3.3.16": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.4",
    "tar": "7.5.21",
    "undici": "7.29.1",
    "vite": "8.0.16"
  },
  "packageManager": "yarn@4.5.1"
}
